	cd /home/adamgb/phd/gazebo_ws/build/px4 && $(MAKE) $(MAKESILENT) -f src/modules/ekf2/test/sensor_simulator/CMakeFiles/ecl_sensor_sim.dir/build.make src/modules/ekf2/test/sensor_simulator/CMakeFiles/ecl_sensor_sim.dir/vio.cpp.i
.PHONY : vio.cpp.i

vio.s: vio.cpp.s
.PHONY : vio.s

# target to generate assembly for a file
vio.cpp.s:
	cd /home/adamgb/phd/gazebo_ws/build/px4 && $(MAKE) $(MAKESILENT) -f src/modules/ekf2/test/sensor_simulator/CMakeFiles/ecl_sensor_sim.dir/build.make src/modules/ekf2/test/sensor_simulator/CMakeFiles/ecl_sensor_sim.dir/vio.cpp.s
.PHONY : vio.cpp.s

