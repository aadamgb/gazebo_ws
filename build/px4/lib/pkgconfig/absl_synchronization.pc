exec_prefix=${prefix}
libdir=/home/adamgb/phd/gazebo_ws/install/px4/lib
includedir=/home/adamgb/phd/gazebo_ws/install/px4/include

Name: absl_synchronization
Description: Abseil synchronization library
URL: https://abseil.io/
Version: head
Requires: absl_graphcycles_internal = head, absl_kernel_timeout_internal = head, absl_atomic_hook = head, absl_base = head, absl_base_internal = head, absl_config = head, absl_core_headers = head, absl_dynamic_annotations = head, absl_malloc_internal = head, absl_nullability = head, absl_raw_logging_internal = head, absl_stacktrace = head, absl_symbolize = head, absl_tracing_internal = head, absl_time = head, absl_tracing_internal = head
Libs: -L${libdir}  -labsl_synchronization 
Cflags: -I${includedir} -DNOMINMAX
