<?xml version="1.0"?>

<model>
  <name>Checkerboard plane</name>
  <version>1.0</version>
  <sdf version="1.7">model.sdf</sdf>

  <description>
    Flat ground plane with a MuJoCo-style checkerboard texture.
    The texture maps once across the plane, so the square count in
    materials/textures/checker.png sets the world-space square size.
  </description>
</model>
